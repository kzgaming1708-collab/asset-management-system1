# Copy file này thành .env rồi điền giá trị:  cp .env.example .env
# File .env chứa bí mật, KHÔNG đẩy lên GitHub (đã nằm trong .gitignore).

# --- Django ---
# Tạo khoá ngẫu nhiên:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=doi-thanh-chuoi-bi-mat-dai-va-ngau-nhien
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*

# --- Database: Supabase ---
# Supabase > Connect > Session pooler > copy chuỗi, thay [YOUR-PASSWORD] bằng mật khẩu thật.
# Mật khẩu có ký tự đặc biệt (@ # / : ?) phải mã hoá, vd @ -> %40. Cách dễ: đặt mật khẩu Supabase chỉ gồm chữ và số.
# Dạng chuỗi:  postgresql://postgres.<mã-project>:<mật-khẩu>@aws-0-<vùng>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Đăng nhập bằng Google ---
# OAuth Client ID (Web application) từ Google Cloud Console. Để trống = ẩn nút Google.
# Dạng:  123456789-abcdefg.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# --- Dữ liệu mẫu ---
# 0 = không tạo dữ liệu mẫu (nên dùng với Supabase thật). 1 = tạo 12 tài sản + 3 tài khoản demo, mật khẩu ai cũng biết.
SEED_DEMO_DATA=0
# 1 = hiện nút điền sẵn tài khoản demo ở trang đăng nhập (chỉ để chạy thử)
VITE_SHOW_DEMO=0

# --- Chỉ dùng khi chạy Postgres trong Docker (docker-compose.local.yml) ---
POSTGRES_DB=assetdb
POSTGRES_USER=assetuser
POSTGRES_PASSWORD=doi-mat-khau-nay
